generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// AfyaNine domain models
// ------------------------------------------------------------------

model Mother {
  id           String         @id @default(cuid())
  code         String         @unique // e.g. MW-1048 (clinic ID)
  fullName     String
  firstName    String
  age          Int
  phone        String
  color        String // avatar colour token
  dueDate      DateTime // pregnancy week is derived from this
  device       String         @default("AfyaBand")
  sizeNote     String         @default("About the size of an eggplant")
  simulated    Boolean        @default(false) // bot-owned test account when true
  readings     VitalReading[]
  notes        VisitNote[]
  appointments Appointment[]
  emergencies  Emergency[]
}

model VitalReading {
  id        String   @id @default(cuid())
  motherId  String
  mother    Mother   @relation(fields: [motherId], references: [id], onDelete: Cascade)
  takenAt   DateTime
  systolic  Int
  diastolic Int
  heartRate Int
  source    String   @default("AfyaBand")

  @@index([motherId, takenAt])
}

model VisitNote {
  id        String   @id @default(cuid())
  motherId  String
  mother    Mother   @relation(fields: [motherId], references: [id], onDelete: Cascade)
  author    String // CHW name
  body      String
  createdAt DateTime @default(now())

  @@index([motherId, createdAt])
}

model Appointment {
  id          String   @id @default(cuid())
  motherId    String
  mother      Mother   @relation(fields: [motherId], references: [id], onDelete: Cascade)
  label       String // e.g. "NEXT ANC VISIT"
  place       String
  scheduledAt DateTime

  @@index([motherId, scheduledAt])
}

model Emergency {
  id        String   @id @default(cuid())
  motherId  String
  mother    Mother   @relation(fields: [motherId], references: [id], onDelete: Cascade)
  kind      String // "Bleeding", "Labour", ...
  status    String   @default("active") // active | resolved
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

enum CareRole {
  MOTHER
  CHW
  PARTNER
}

enum CareScope {
  VITALS
  PREGNANCY
  VISITS
  NOTES
  CONTACTS
}

enum CareInviteKind {
  CHW
  PARTNER
}

enum CareInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CareVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model CareAccount {
  id                 String   @id
  email              String
  displayName        String
  phone              String?
  role               CareRole
  locale             String   @default("EN")
  isDemo             Boolean  @default(false)
  institutionName    String?
  registrationNumber String?
  institutionContact String?
  verifiedAt         DateTime?
  verifiedBy         String?
  dueDate            DateTime?
  storageScopes      CareScope[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sentInvites        CareInvite[] @relation("CareSender")
  motherInvites      CareInvite[] @relation("CareInviteMother")
  motherAccess       CareAccess[] @relation("CareMother")
  viewerAccess       CareAccess[] @relation("CareViewer")
  maternalVisits     CareVisit[] @relation("CareVisitMother")
  chwVisits          CareVisit[] @relation("CareVisitChw")
  vitals             CareVital[]
  contacts           CareContact[]
  authoredNotes      CareNote[]

  @@index([isDemo, email])
}

model CareInvite {
  id             String @id @default(cuid())
  requesterId    String
  requester      CareAccount @relation("CareSender", fields: [requesterId], references: [id])
  motherId       String?
  mother         CareAccount? @relation("CareInviteMother", fields: [motherId], references: [id])
  targetEmail    String
  kind           CareInviteKind
  scopes         CareScope[]
  status         CareInviteStatus @default(PENDING)
  isDemo         Boolean @default(false)
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime @default(now())
  access         CareAccess?

  @@index([targetEmail, isDemo, status])
  @@index([requesterId, createdAt])
}

model CareAccess {
  id          String @id @default(cuid())
  motherId    String
  mother      CareAccount @relation("CareMother", fields: [motherId], references: [id])
  viewerId    String
  viewer      CareAccount @relation("CareViewer", fields: [viewerId], references: [id])
  kind        CareInviteKind
  scopes      CareScope[]
  active      Boolean @default(true)
  isDemo      Boolean @default(false)
  inviteId    String @unique
  invite      CareInvite @relation(fields: [inviteId], references: [id])
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([motherId, active])
  @@index([viewerId, active])
}

model CareVisit {
  id          String @id @default(cuid())
  motherId    String
  mother      CareAccount @relation("CareVisitMother", fields: [motherId], references: [id])
  chwId       String
  chw         CareAccount @relation("CareVisitChw", fields: [chwId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  place       String
  status      CareVisitStatus @default(SCHEDULED)
  isDemo      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       CareNote[]

  @@index([chwId, startsAt])
  @@index([motherId, startsAt])
}

model CareNote {
  id          String @id @default(cuid())
  visitId     String
  visit       CareVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  authorId    String
  author      CareAccount @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime @default(now())
}

model CareVital {
  id          String @id @default(cuid())
  motherId    String
  mother      CareAccount @relation(fields: [motherId], references: [id], onDelete: Cascade)
  systolic    Int
  diastolic   Int
  heartRate   Int
  measuredAt  DateTime @default(now())

  @@index([motherId, measuredAt])
}

model CareContact {
  id           String @id @default(cuid())
  motherId     String
  mother       CareAccount @relation(fields: [motherId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  createdAt    DateTime @default(now())
}

model CareAudit {
  id        String @id @default(cuid())
  actorId   String
  motherId  String?
  action    String
  scopes    CareScope[] @default([])
  isDemo    Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([motherId, createdAt])
}
